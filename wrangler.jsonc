{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Nest's own domain. workers.dev and preview URLs are off for this Worker only; other Workers on the
  // account keep theirs.
  "routes": [{ "pattern": "nestagents.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The UI is one page; /o/<objective> and /p/<project> are its routes.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/mcp", "/shots/*"] },

  "vars": {
    "ACCOUNT_ID": "461aad8037e6c7bda5bac789d1393a75",
    "ARTIFACTS_NAMESPACE": "nest",
    "AI_GATEWAY_ID": "nest",
    "AI_GATEWAY_MODE": "gateway",
    "AGENT_MODEL_OPENAI": "gpt-6-luna",
    "AGENT_MODEL_ANTHROPIC": "anthropic/claude-haiku-5.5",
    "REVIEW_MODEL_OPENAI": "gpt-6-luna",
    "REVIEW_MODEL_ANTHROPIC": "anthropic/claude-haiku-5.5",
    "REVIEW_MODEL_WORKERS_AI": "@cf/openai/gpt-oss-120b",
    "SPEND_CAP_MICRO_USD": "50000000",
    "AUTO_REPAIR_AGENT": "kestrel",
    "PUBLIC_URL": "https://nestagents.dev"
  },

  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "nest" }],

  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "PROJECTS", "class_name": "ProjectDO" },
      { "name": "OBJECTIVES", "class_name": "ObjectiveDO" },
      { "name": "COMPUTERS", "class_name": "Computer" }
    ]
  },
  "exports": {
    "RegistryDO": { "type": "durable-object", "storage": "sqlite" },
    "ProjectDO": { "type": "durable-object", "storage": "sqlite" },
    "ObjectiveDO": { "type": "durable-object", "storage": "sqlite" },
    "Computer": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "Computer",
      "scheduling_policy": "durable_object",
      "images": {
        "agent": { "dockerfile": "./container/Dockerfile.agent", "build_context": "." },
        "runner": { "dockerfile": "./container/Dockerfile.runner", "build_context": "." }
      }
    }
  ],

  "workflows": [
    { "name": "nest-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
    { "name": "nest-task", "binding": "TASKS", "class_name": "TaskWorkflow" },
    { "name": "nest-review", "binding": "REVIEWS", "class_name": "ReviewWorkflow" },
    { "name": "nest-compose", "binding": "COMPOSE", "class_name": "ComposeWorkflow" }
  ],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "nest" },
        "targets": [{ "type": "workflow", "workflow_name": "nest-ingest" }]
      }
    ]
  },

  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "nest-objects" }],
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "nest_events" }],

  "secrets": { "required": ["NEST_OWNER_TOKEN", "NEST_SIGNING_KEY", "OPENAI_API_KEY", "OPENROUTER_API_KEY", "CF_AIG_TOKEN"] }
}
