# Agent computer: git, ripgrep, Node 24, Codex CLI, the nest CLI and the nest-agent harness.
FROM node:24-trixie-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep jq procps \
  && rm -rf /var/lib/apt/lists/*
RUN npm install --global --ignore-scripts @openai/codex@0.156.1
COPY --from=docker.io/cloudflare/sandbox:1.0.0 /usr/local/bin/sandbox-shim /usr/local/bin/sandbox-shim
COPY container/nest /usr/local/bin/nest
COPY container/nest-agent.mjs /opt/nest/nest-agent.mjs
RUN chmod 0755 /usr/local/bin/nest && mkdir -p /workspace/nest
WORKDIR /workspace
CMD ["sleep", "infinity"]
